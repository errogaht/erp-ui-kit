{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true,
    "types": ["vite/client"],
    "verbatimModuleSyntax": true, "skipLibCheck": true,
    "allowSyntheticDefaultImports": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "noEmit": true
  },
  "include": ["src", "docs", "vite.lib.config.ts", "vite.docs.config.ts"]
}
